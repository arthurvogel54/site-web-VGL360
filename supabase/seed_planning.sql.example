insert into public.planning_entries (user_id, entry_date, day_type, company_id)
select r.user_id, r.entry_date::date, r.day_type,
  case r.company_slug when 'quentin' then c.quentin_id when 'arthur' then c.arthur_id else null end
from c, telma_rows r
union all
select r.user_id, r.entry_date::date, r.day_type,
  case r.company_slug when 'quentin' then c.quentin_id when 'arthur' then c.arthur_id else null end
from c, enzo_rows r
on conflict (user_id, entry_date) do update
  set day_type = excluded.day_type, company_id = excluded.company_id;
